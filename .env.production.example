# Copy to .env.production and replace every placeholder before deployment.
ENVIRONMENT=production
PROJECT_NAME=FixIt - Campus Support Platform
API_V1_STR=/api

# Generate a unique random value of at least 64 characters.
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Use a production MongoDB Atlas URI with a dedicated least-privilege app user.
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_LONG_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=fixit_db
FALLBACK_TO_MOCK_DB=false

# Replace with the real public frontend/backend hostnames.
ALLOWED_HOSTS=["YOUR_FIXIT_DOMAIN","localhost","127.0.0.1"]
BACKEND_CORS_ORIGINS=["https://YOUR_FIXIT_DOMAIN"]

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_DEMO_DATA=false
PUBLIC_REGISTRATION_ENABLED=true
DOCS_ENABLED=false

# Public frontend origin used for email verification and ticket links.
APP_BASE_URL=https://YOUR_FIXIT_DOMAIN

# Required for public self-registration: SMTP delivers one-time college email verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
